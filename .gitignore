# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── Virtual environments ────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Auto-generated agent memory (created at runtime) ─────────────────
agents/*/memory/
agents/CUSTOMER_SERVICE

# ── Agent-generated output (architecture, test plans, etc.) ──────────
agents/*/output/
agents/*/.backup

# ── JOB AGENT ──────────
agents/JOB_HUNTER
JOBS.md

# ── Runtime registry ────────────────────────────────────────────────
.agenthost-registry.json
agents.yaml

# ── Backup info ────────────────────────────────────────────────
.agenthost

# ── Sensitive credentials & keys ────────────────────────────────────
keys.kdbx
.env
.env.local
*.key
*.pem
*.cert

# ── IDE / Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ── OS junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tool caches ─────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mypy/

# ── Build output (wheel tarballs, etc.) ─────────────────────────────
*.whl
*.tar.gz

