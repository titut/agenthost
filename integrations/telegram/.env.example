# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL of the running agenthost agent's /chat endpoint
AGENT_CHAT_URL=http://127.0.0.1:8000/chat

# Optional: URL of the agent's /health endpoint (auto-derived from AGENT_CHAT_URL by default)
# AGENT_HEALTH_URL=http://127.0.0.1:8000/health

# Optional: long-polling timeout in seconds
TELEGRAM_POLL_TIMEOUT=30

# Optional: how many times to retry a failed agent request
AGENT_RETRIES=3

# Optional: seconds to wait between retries
AGENT_RETRY_DELAY=2

# Optional: log level (silent, error, warn, info, debug, trace)
LOG_LEVEL=info
