# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL of the running agenthost agent's /chat endpoint
AGENT_CHAT_URL=http://127.0.0.1:8000/chat

# Optional: URL of the agent's /health endpoint (auto-derived from AGENT_CHAT_URL by default)
# AGENT_HEALTH_URL=http://127.0.0.1:8000/health

# Optional: comma-separated list of Telegram usernames allowed to use this bot.
# If empty, all users are allowed. Do not include the leading @.
ALLOWED_USERNAMES=your_telegram_username

# Optional: long-polling timeout in seconds
TELEGRAM_POLL_TIMEOUT=30

# Optional: proxy for Telegram API calls.
# Useful when the host network has poor routing to api.telegram.org.
# Examples:
#   TELEGRAM_PROXY=http://proxy.example.com:8080
#   TELEGRAM_PROXY=socks5://user:pass@proxy.example.com:1080
# For SOCKS5 support, install httpx with socks: pip install "httpx[socks]"
# TELEGRAM_PROXY=

# Optional: Telegram API connect/read timeouts in seconds
# TELEGRAM_CONNECT_TIMEOUT=30
# TELEGRAM_READ_TIMEOUT=60

# Optional: how many times to retry a failed agent request
AGENT_RETRIES=3

# Optional: seconds to wait between retries
AGENT_RETRY_DELAY=2

# Optional: log level (silent, error, warn, info, debug, trace)
LOG_LEVEL=info
