# Get this from the Discord Developer Portal:
#   https://discord.com/developers/applications
# Create a bot, copy the token, and enable the "Message Content Intent" and
# "Direct Messages" intents under Privileged Gateway Intents.
DISCORD_BOT_TOKEN=your_bot_token_here

# URL of the running agenthost agent's /chat endpoint
AGENT_CHAT_URL=http://127.0.0.1:8000/chat

# Optional: URL of the agent's /health endpoint (auto-derived from AGENT_CHAT_URL by default)
# AGENT_HEALTH_URL=http://127.0.0.1:8000/health

# Optional: comma-separated list of Discord user IDs allowed to use this bot.
# If empty, all users are allowed. User IDs are numeric and stable.
# DM the bot with !id to find your user ID.
ALLOWED_USER_IDS=your_discord_user_id

# Optional: restrict the bot to specific guilds (server IDs).
# If empty, the bot can respond in any guild it is a member of.
# ALLOWED_GUILD_IDS=123456789012345678

# Optional: restrict the bot to specific channel IDs.
# If empty, the bot can respond in any channel it can see.
# ALLOWED_CHANNEL_IDS=123456789012345678

# Optional: guild prefix trigger. If set, messages starting with this prefix
# in a guild channel will also be forwarded to the agent (in addition to mentions).
# DISCORD_GUILD_PREFIX=!ai

# Optional: how many times to retry a failed agent request
AGENT_RETRIES=3

# Optional: seconds to wait between retries
AGENT_RETRY_DELAY=2

# Optional: host and port for the outbound HTTP server (used by agent's send_discord tool)
# BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=9005

# Optional: log level (silent, error, warn, info, debug, trace)
LOG_LEVEL=info
