# URL of the running agent's chat endpoint
AGENT_CHAT_URL=http://127.0.0.1:8000/chat

# Optional: shown in logs
AGENT_NAME=RESEARCHER

# WhatsApp auth state directory. Baileys stores session data here so you
# only need to scan the QR code once.
AUTH_STATE_DIR=./auth_state

# Optional: log level.
#   silent  - nothing
#   error   - errors only
#   warn    - errors + warnings
#   info    - normal flow (default)
#   debug   - verbose bridge logs (recommended for troubleshooting)
#   trace   - debug + very noisy Baileys internal logs
LOG_LEVEL=info

# Optional: who can trigger the agent.
#   By default, the agent responds to incoming messages from other people.
#   Set RESPOND_TO_FROM_ME=true to also respond to messages you send from
#   your own phone.
RESPOND_TO_OTHERS=true
RESPOND_TO_FROM_ME=false

# Prefixes used to tag AI replies and system messages.
#   The bridge ignores messages that start with these prefixes, so AI replies
#   and system notifications do not trigger the agent again.
AI_PREFIX=/ai
SYSTEM_PREFIX=/system

# Message sent when the user sends a new message while the agent is still
# processing the previous one in the same chat.
BUSY_MESSAGE=agent is busy, wait for response before sending another message

# Optional: outbound WhatsApp target. If set, the bridge exposes a /send endpoint
# that the agent can call to push messages to WhatsApp (e.g. from scheduled events).
WHATSAPP_TARGET_JID=1234567890@s.whatsapp.net
BRIDGE_HTTP_PORT=9001
